<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.LoginController">
    <children>
        <MenuBar style="-fx-background-color: #0047AB;" VBox.vgrow="NEVER">
            <menus>
                <Menu mnemonicParsing="false" style="-fx-color: #0000;" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Quit" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" style="-fx-color: #0000;" text="Edit" />
                <Menu mnemonicParsing="false" style="-fx-color: #0000;" text="Help" />
            </menus>
        </MenuBar>

        <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" style="-fx-background-color: #000829;" VBox.vgrow="ALWAYS">
            <children>
                <Label alignment="CENTER" layoutX="211.0" layoutY="40.0" prefHeight="50.0" prefWidth="218.0" text="SiGCVet" textFill="WHITE">
                    <font>
                        <Font name="System Bold Italic" size="36.0" />
                    </font>
                </Label>

                <Label alignment="CENTER" layoutX="170.0" layoutY="100.0" prefHeight="20.0" prefWidth="300.0" text="Introduzca su usuario y contraseña por favor" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Label layoutX="155.0" layoutY="158.0" text="Usuario:" textFill="WHITE">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <TextField fx:id="txtUsuario" layoutX="243.0" layoutY="153.0" prefHeight="35.0" prefWidth="200.0" style="-fx-background-radius: 5;" />

                <Label layoutX="126.0" layoutY="208.0" text="Contraseña:" textFill="WHITE">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <PasswordField fx:id="txtContrasena" layoutX="244.0" layoutY="208.0" prefHeight="35.0" prefWidth="200.0" style="-fx-background-radius: 5;" />

                <Button fx:id="btnAceptar" layoutX="271.0" layoutY="270.0" mnemonicParsing="false" onAction="#manejarLogin" prefHeight="45.0" prefWidth="105.0" style="-fx-background-color: #00C853; -fx-background-radius: 10; -fx-text-fill: white;" text="Aceptar">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Label fx:id="lblMensaje" alignment="CENTER" layoutX="120.0" layoutY="330.0" prefHeight="20.0" prefWidth="400.0" textFill="#ff5252">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </children>
</VBox>